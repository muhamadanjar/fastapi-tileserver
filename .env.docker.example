# Docker Compose configuration only. Copy to .env.docker before using a Docker
# target. Local Python commands continue to use .env instead.

# Docker-facing infrastructure endpoints. These default to Compose service
# names; change them to host.docker.internal or remote endpoints when using
# external infrastructure.
TILESERVER_DB_TYPE=postgresql
TILESERVER_DB_HOST=postgres
TILESERVER_DB_PORT=5432
TILESERVER_DB_USER=postgres
TILESERVER_DB_PASSWORD=postgres
TILESERVER_DB_NAME=gis_db
TILESERVER_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
TILESERVER_REDIS_URL=redis://redis:6379/0
# Address the CONTAINER uses to reach GeoServer for publishing. Use the Compose
# service name (geoserver) only when GeoServer runs in this stack; use
# host.docker.internal when GeoServer runs on the host machine.
TILESERVER_GEOSERVER_URL=http://host.docker.internal:8080/geoserver

# Ports exposed from Docker Compose to the host.
TILESERVER_API_PORT=8000
TILESERVER_POSTGRES_PORT=5432
TILESERVER_RABBITMQ_PORT=5672
TILESERVER_RABBITMQ_MANAGEMENT_PORT=15672
TILESERVER_REDIS_PORT=6379
TILESERVER_GEOSERVER_PORT=8080

# Application settings passed into Docker containers. Configure real secrets in
# .env.docker; do not copy local .env automatically.
AUTH_DISABLED=false
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_PUBLIC_KEY=
ACCESS_TOKEN_ALGORITHMS=HS256,RS256
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
# Public WMS/WFS base URL stored in each layer's tile_url_template (what client
# browsers use to load tiles). MUST be set when GeoServer is on the host: a bare
# GEOSERVER_URL of host.docker.internal is only resolvable inside the container
# and would leave clients with unreachable tile URLs. Use the host- or LAN-visible
# address, e.g. http://localhost:8080/geoserver.
GEOSERVER_WMS_URL=http://localhost:8080/geoserver
GEOSERVER_WORKSPACE=tileserver
UPLOAD_API_URL=http://host.docker.internal:8010/api/v1
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=http://host.docker.internal:8000/oauth/token
OAUTH_AUDIENCE=upload-api
OAUTH_SCOPES=upload.artifacts.read upload.artifacts.lease
STORAGE_NETWORK_NAME=usermanagement_api_usermanagement_network
