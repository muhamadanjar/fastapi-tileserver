# Database
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gis_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379/0

# Upload
CHUNK_UPLOAD_THRESHOLD=10485760

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3001,http://localhost:8070
CORS_ALLOWED_CREDENTIALS=True
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With,Content-Range
