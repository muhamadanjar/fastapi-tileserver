# Database
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gis_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379/0

# Upload
CHUNK_UPLOAD_THRESHOLD=10485760
SHP_IMPORT_MAX_UNCOMPRESSED_BYTES=1073741824
SHP_IMPORT_MAX_FEATURES=1000000
SHP_IMPORT_BATCH_SIZE=5000
SHP_IMPORT_MAX_COMPRESSION_RATIO=200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3001,http://localhost:8070
CORS_ALLOWED_CREDENTIALS=True
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,X-Requested-With,Content-Range

# User Management JWT verification. For HS256, this must equal User Management's
# SECRET_KEY. For production, prefer RS256 and configure only ACCESS_TOKEN_PUBLIC_KEY.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_PUBLIC_KEY=
ACCESS_TOKEN_ALGORITHMS=HS256,RS256
AUTH_DISABLED=false

GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_URL=http://localhost:8080/geoserver
# Public WMS/WFS base URL stored in each layer's tile_url_template (what client
# browsers use to load tiles). Optional locally (defaults to GEOSERVER_URL), but
# required when tileserver runs in a container and GeoServer is on the host.
# GEOSERVER_WMS_URL=http://localhost:8080/geoserver
GEOSERVER_WORKSPACE=tileserver
UPLOAD_API_URL=http://localhost:8010/api/v1
# Provision this client from User Management's per-environment service manifest.
# OAUTH_AUDIENCE and OAUTH_SCOPES must match that client's allowed_audiences and
# audience_permissions: only then does User Management issue usable tokens.
OAUTH_CLIENT_ID=
# Load from the environment secret manager; never commit a real value.
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_URL=http://usermanagement-api:8000/oauth/token
OAUTH_AUDIENCE=upload-api
OAUTH_SCOPES=upload.artifacts.read upload.artifacts.lease
# DEPRECATED fallback during OAuth migration only:
# UPLOAD_API_SERVICE_TOKEN=
# UPLOAD_API_CALLER_TOKEN=
