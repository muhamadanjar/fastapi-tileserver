[Unit]
Description=FastAPI TileServer with Gunicorn + UvicornWorker
After=network.target
[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/tileserver_dev
EnvironmentFile=/var/www/tileserver_dev/.env
ExecStart=/var/www/tileserver_dev/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8050
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target